    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Lectura rápida",
                    "textStyle": {
                      "fontSize": "12pt",
                      "color": "#111827",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Solo el 6,8 % de las entregas llega tarde, pero la nota media cae de 4,29 (en plazo) a 2,27 (con retraso).",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Con 1-3 días de retraso la nota baja a 3,29; con 4-7 días, a 2,10; y con más de una semana, a 1,70.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Los mayores retrasos están en Maranhão (17 %), Ceará (14 %), Bahía (12 %) y Río de Janeiro (12 %); en São Paulo, el 4,5 %.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              },
              {
                "textRuns": [
                  {
                    "value": "•  Es una relación observada en los datos: no prueba por sí sola que el retraso cause la mala nota.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  }
                ],
                "horizontalTextAlignment": "Left"
              }
            ]
          }
        }
      ]
    },

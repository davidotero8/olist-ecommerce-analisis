table Vendedores
	lineageTag: 43f6e77f-cc82-48c2-8578-710ef778c24c

	measure 'Vendedores para el 80%' = CALCULATE ( MIN ( Vendedores[ranking] ), Vendedores[pct_acumulado] >= 80 )
		formatString: 0
		lineageTag: 7d5df219-726b-4e47-b45d-d79c1e6b3bd0

	measure 'Vendedores totales' = COUNTROWS ( Vendedores )
		formatString: 0
		lineageTag: ba695bdc-65e0-456c-9cb8-f942dbccdf4b

	measure '% de vendedores para el 80%' = DIVIDE ( [Vendedores para el 80%], [Vendedores totales] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 8b54a579-7d3d-4103-973c-d7e3d652bdea


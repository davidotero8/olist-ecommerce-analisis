table Pedidos
	lineageTag: a3022bd3-c039-4ac7-bb38-2ebfad7926cd

	measure 'Ingresos Totales' = CALCULATE ( SUM ( Pedidos[ingresos] ), Pedidos[estado_pedido] = "delivered" )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 0db252ea-2b84-48f8-8e81-a5049b7405b3

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Pedidos entregados' = CALCULATE ( COUNTROWS ( Pedidos ), Pedidos[estado_pedido] = "delivered" )
		formatString: #,0.000
		lineageTag: f104d7e3-be5d-4af0-b83a-43674b70a9f3

	measure 'Nota media' = CALCULATE ( AVERAGE ( Pedidos[nota] ), Pedidos[estado_pedido] = "delivered" )
		formatString: 0.00
		lineageTag: 1c82508d-82d6-4391-93f8-75bdd7eb6e22

	measure 'Ticket medio' = DIVIDE ( [Ingresos Totales], [Pedidos entregados] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 0b18e987-3787-49a7-8038-09b974e214ad

		annotation PBI_FormatHint = {"currencyCulture":"pt-BR"}

	measure 'Entregas tardías' = AVERAGE ( Pedidos[entrega_tardia] )
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 55dbfc08-5698-407c-b63b-0e8ac4c7d645

	measure 'Nota media con retraso' = CALCULATE ( [Nota media], Pedidos[entrega_tardia] = 1 )
		lineageTag: 4b29dbe1-dde7-4a37-980e-746f36669ceb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nota media en plazo' = CALCULATE ( [Nota media], Pedidos[entrega_tardia] = 0 )
		lineageTag: 29a19f79-7ac4-4223-a30c-7bccdc8f7a6f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

